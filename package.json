{
  "name": "meu-racha",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "cd apps/mobile && bunx expo start",
    "ios": "cd apps/mobile && bunx expo run:ios",
    "android": "cd apps/mobile && bunx expo run:android",
    "test": "bun run --filter @meu-racha/domain test",
    "lint": "bun run --filter '*' lint",
    "typecheck": "bun run --filter '*' typecheck",
    "db:start": "bunx supabase start",
    "db:stop": "bunx supabase stop",
    "db:reset": "bunx supabase db reset",
    "db:types": "bunx supabase gen types typescript --local > apps/mobile/src/lib/database.types.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@types/bun": "latest",
    "@typescript-eslint/parser": "^8.70.1",
    "eslint": "^9",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.9",
    "supabase": "^2.117.0",
    "typescript": "~6.0.3"
  }
}
