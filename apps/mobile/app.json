{
  "expo": {
    "name": "meu racha",
    "slug": "meu-racha-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "meuracha",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "app.meuracha",
      "appleTeamId": "F7MJN7SK3C"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#07180F",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "allowBackup": false,
      "predictiveBackGestureEnabled": false,
      "package": "app.meuracha",
      "googleServicesFile": "./google-services.json"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#07180F",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 288
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Manrope-Medium.ttf",
            "./assets/fonts/Manrope-Bold.ttf",
            "./assets/fonts/Manrope-ExtraBold.ttf",
            "./assets/fonts/BarlowCondensed-Bold.ttf"
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O Meu Racha usa suas fotos para você escolher a foto da sua carta.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#07180F"
        }
      ],
      "./plugins/with-scene-delegate.js",
      "./plugins/with-release-signing.js",
      "expo-secure-store",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6ec030d4-a09c-4d60-afad-0c18b4e226d0"
      }
    },
    "owner": "filubilce"
  }
}
